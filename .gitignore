# Built programs: rebuild with build.bat after cloning or pulling
/*.exe

# Documents kept outside the repository (report and flowcharts)
/docs/

# Assembler and editor leftovers
*.obj
*.o
*.map
*.lst
*.tmp
*.bak

# Save files written by the programs (stock, coins, sales, admin settings)
*.dat
*.DAT

# Bridge files created each time vending.exe runs in bridge mode (used by the GUI)
CMD.TXT
OUT.TXT

# Python
__pycache__/
*.pyc

# Output files DOSBox may write when it runs without its console window
stdout.txt
stderr.txt
